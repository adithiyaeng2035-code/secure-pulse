FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SECUREPULSE_REQUIRE_API_TOKEN=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY modules ./modules
COPY generate_data.py train_model.py README.md ./
RUN python generate_data.py \
    && python train_model.py \
    && useradd --create-home --uid 10001 securepulse \
    && chown -R securepulse:securepulse /app

USER securepulse

EXPOSE 8080

CMD ["sh", "-c", "uvicorn modules.api:app --host 0.0.0.0 --port ${PORT:-8080}"]
